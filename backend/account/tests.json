{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "GET без resource",
      "method": "GET",
      "path": "/",
      "expectedStatus": 400
    },
    {
      "name": "GET presence (публичный онлайн-счётчик)",
      "method": "GET",
      "path": "/?resource=presence",
      "expectedStatus": 200
    },
    {
      "name": "GET orders без токена",
      "method": "GET",
      "path": "/?resource=orders",
      "expectedStatus": 401
    },
    {
      "name": "GET order-status без параметров",
      "method": "GET",
      "path": "/?resource=order-status",
      "expectedStatus": 400
    },
    {
      "name": "GET order-status несуществующий заказ",
      "method": "GET",
      "path": "/?resource=order-status&orderId=999999&token=abc",
      "expectedStatus": 404
    },
    {
      "name": "POST tbank-notify без подписи",
      "method": "POST",
      "path": "/?resource=payment&action=tbank-notify",
      "body": "{}",
      "expectedStatus": 400
    }
  ]
}